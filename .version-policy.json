{
  "schema": 1,
  "bumpPolicy": "every-deliverable",
  "versionSource": "VERSION",
  "tagPattern": "v{version}",
  "tagPolicy": "every-version",
  "githubReleasePolicy": "on-version-commit",
  "distributionPolicy": "released-tags-only",
  "publishPolicy": "manual",
  "releaseBranch": "main",
  "wipPrefixes": [
    "wip:"
  ],
  "mirrors": [
    {
      "path": "package.json",
      "pointer": "/version"
    }
  ]
}
