{
  "name": "openbot",
  "private": true,
  "version": "0.15.1",
  "type": "module",
  "description": "Self-hosted Grok Bot. Named Bots on one Computer.",
  "scripts": {
    "test": "node scripts/test.mjs full",
    "test:focused": "node scripts/test.mjs focused",
    "test:live:harness": "node scripts/test.mjs live:harness",
    "test:live:screen": "node scripts/test.mjs live:screen",
    "test:live:pinchtab": "node scripts/test.mjs live:pinchtab",
    "typecheck": "tsc -p daemon/tsconfig.json --noEmit && tsc -p pwa/tsconfig.json --noEmit",
    "build:pwa": "vite build --config pwa/vite.config.ts",
    "start": "tsx daemon/src/start.ts",
    "dev:pwa": "vite --config pwa/vite.config.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12"
  }
}
