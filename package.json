{
  "name": "openbot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Self-hosted Grok Bot. Named Bots on one Computer.",
  "scripts": {
    "test": "tsx --test daemon/test/*.test.ts",
    "typecheck": "tsc -p daemon/tsconfig.json --noEmit && tsc -p pwa/tsconfig.json --noEmit",
    "build:pwa": "vite build --config pwa/vite.config.ts",
    "start": "tsx daemon/src/index.ts",
    "dev:pwa": "vite --config pwa/vite.config.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12"
  }
}
