#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
export XDG_SESSION_TYPE=x11
export GDK_BACKEND=x11
export QT_QPA_PLATFORM=xcb
export GTK_THEME=Adwaita
n="${DISPLAY#:}"
export XDG_CONFIG_HOME="${HOME}/.config-d${n}"
export XDG_CACHE_HOME="${HOME}/.cache-d${n}"
export XDG_DATA_HOME="${HOME}/.local/share-d${n}"
if [ -n "${CHROME_USER_DATA_DIR:-}" ] && [ "$n" = "1" ]; then
  PROFILE="$CHROME_USER_DATA_DIR"
elif [ "$n" = "1" ]; then
  PROFILE="${HOME}/.config/google-chrome"
else
  PROFILE="${HOME}/.config/google-chrome-d${n}"
fi
export CHROME_USER_DATA_DIR="$PROFILE"
mkdir -p "$PROFILE" \
  "$XDG_CONFIG_HOME/xfce4/xfconf/xfce-perchannel-xml" \
  "$XDG_CONFIG_HOME/xfce4/panel/launcher-1" \
  "$XDG_CONFIG_HOME/xfce4/panel/launcher-2" \
  "$XDG_CONFIG_HOME/xfce4/panel/launcher-3"
XML=/etc/xdg/xfce4/xfconf/xfce-perchannel-xml
if [ -d "$XML" ]; then
  cp -n "$XML/xfwm4.xml" "$XDG_CONFIG_HOME/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml" 2>/dev/null || true
  cp -n /etc/xdg/xfce4/panel/default.xml "$XDG_CONFIG_HOME/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml" 2>/dev/null || true
  cp -n "$XML/displays.xml" "$XDG_CONFIG_HOME/xfce4/xfconf/xfce-perchannel-xml/displays.xml" 2>/dev/null || true
  cp -n "$XML/xfce4-desktop.xml" "$XDG_CONFIG_HOME/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml" 2>/dev/null || true
  cp -n "$XML/xsettings.xml" "$XDG_CONFIG_HOME/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml" 2>/dev/null || true
  cp -n "$XML/xfce4-session.xml" "$XDG_CONFIG_HOME/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml" 2>/dev/null || true
fi
for i in 1 2 3; do
  cp -n /etc/xdg/xfce4/panel/launcher-$i/*.desktop "$XDG_CONFIG_HOME/xfce4/panel/launcher-$i/" 2>/dev/null || true
done
rm -rf "$XDG_CACHE_HOME/sessions"
xsetroot -solid "#e8eaed"
startxfce4 &
sleep 2
xsetroot -solid "#e8eaed"
xfconf-query -c displays -p /Notify -n -t bool -s false >/dev/null 2>&1 || true
xfconf-query -c xfce4-desktop -p /desktop-icons/style -n -t int -s 0 >/dev/null 2>&1 || true
if command -v xfconf-query >/dev/null 2>&1; then
  for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E 'image-style$'); do
    xfconf-query -c xfce4-desktop -p "$prop" -s 0 >/dev/null 2>&1 || true
  done
  for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E 'color-style$'); do
    xfconf-query -c xfce4-desktop -p "$prop" -s 0 >/dev/null 2>&1 || true
  done
fi
# Unique headed profile per display. Shared cookies are copied in/out of
# /computer/cookies by entrypoint. CDP is localhost-only in this container so
# PinchTab can attach to this Chrome. Do not publish CDP.
CHROME_BIN=""
CDP_PORT=$((9221 + n))
if command -v google-chrome-stable >/dev/null 2>&1; then
  CHROME_BIN=google-chrome-stable
elif command -v google-chrome >/dev/null 2>&1; then
  CHROME_BIN=google-chrome
fi
if [ -z "$CHROME_BIN" ]; then
  echo "google-chrome not found on PATH; Chromium is not a fallback" >&2
else
  "$CHROME_BIN" \
    --user-data-dir="$PROFILE" \
    --remote-debugging-port="$CDP_PORT" \
    --remote-debugging-address=127.0.0.1 \
    --remote-allow-origins=* \
    --no-first-run --disable-gpu --no-sandbox --test-type --disable-dev-shm-usage \
    --disable-session-crashed-bubble --hide-crash-restore-bubble --disable-infobars \
    --no-default-browser-check --window-size=1100,700 --window-position=90,40 \
    chrome://new-tab-page &
  /usr/local/bin/openbot-display pinchtab "$n" || true
fi
wait
